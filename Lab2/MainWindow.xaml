<Window x:Class="Lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторная работа №2"
        Height="800" Width="950"
        MinHeight="700" MinWidth="850"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <GroupBox Header="Параметры сигнала" Margin="5">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <StackPanel Margin="5">
                        <TextBlock Text="Частота (Гц):"/>
                        <Slider x:Name="FrequencySlider" Width="180" Minimum="20" Maximum="2000" Value="440"/>
                        <TextBlock x:Name="FrequencyLabel" Text="440" TextAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Амплитуда:"/>
                        <Slider x:Name="AmplitudeSlider" Width="180" Minimum="0.1" Maximum="1.0" Value="0.8"/>
                        <TextBlock x:Name="AmplitudeLabel" Text="0.8" TextAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Частота дискретизации (Гц):"/>
                        <Slider x:Name="SamplingRateSlider" Width="180" Minimum="1000" Maximum="192000" Value="44100"/>
                        <TextBlock x:Name="SamplingRateLabel" Text="44100" TextAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Длительность (с):"/>
                        <Slider x:Name="DurationSlider" Width="180" Minimum="0.05" Maximum="2.0" Value="0.5"/>
                        <TextBlock x:Name="DurationLabel" Text="0.5" TextAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Анализ" Margin="10,0,10,5">
            <WrapPanel Margin="5">
                <TextBlock Text="Тип сигнала:" VerticalAlignment="Center" Margin="5,0,10,0"/>
                <ComboBox x:Name="SignalTypeCombo" SelectedIndex="0" Width="140" Margin="5,0,0,0">
                    <ComboBoxItem Content="Синусоида"/>
                    <ComboBoxItem Content="Сумма двух синусоид"/>
                    <ComboBoxItem Content="Прямоугольный"/>
                    <ComboBoxItem Content="Пилообразный"/>
                </ComboBox>

                <TextBlock Text="Метод:" VerticalAlignment="Center" Margin="20,0,10,0"/>
                <ComboBox x:Name="MethodCombo" SelectedIndex="0" Width="120" Margin="5,0,0,0">
                    <ComboBoxItem Content="ДПФ"/>
                    <ComboBoxItem Content="БПФ"/>
                </ComboBox>

                <Button Content="Спектральный анализ" Margin="15,0,0,0" Padding="12,6" Click="AnalyzeButton_Click"/>
                <Button Content="Восстановить сигнал" Margin="10,0,0,0" Padding="12,6" Click="ReconstructButton_Click"/>
                <Button Content="Показать погрешность" Margin="10,0,0,0" Padding="12,6" Click="ErrorButton_Click"/>
            </WrapPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Фильтрация" Margin="10,0,10,5">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Тип фильтра:" VerticalAlignment="Center" Margin="5,0,10,0"/>
                    <ComboBox x:Name="FilterTypeCombo" SelectedIndex="0" Width="140" SelectionChanged="FilterTypeCombo_SelectionChanged">
                        <ComboBoxItem Content="НЧ-фильтр"/>
                        <ComboBoxItem Content="ВЧ-фильтр"/>
                        <ComboBoxItem Content="Полосовой"/>
                        <ComboBoxItem Content="Режекторный"/>
                    </ComboBox>

                    <TextBlock Text="Частота среза (Гц):" VerticalAlignment="Center" Margin="20,0,10,0"/>
                    <Slider x:Name="CutoffSlider" Width="160" Minimum="50" Maximum="5000" Value="1000"/>
                    <TextBlock x:Name="CutoffLabel" Text="1000" Width="60" TextAlignment="Right" Margin="5,0,0,0"/>

                    <TextBlock x:Name="Cutoff2Text" Text="Вторая частота (Гц):" VerticalAlignment="Center" Margin="20,0,10,0" Visibility="Collapsed"/>
                    <Slider x:Name="Cutoff2Slider" Width="160" Minimum="50" Maximum="5000" Value="2000" Visibility="Collapsed"/>
                    <TextBlock x:Name="Cutoff2Label" Text="2000" Width="60" TextAlignment="Right" Margin="5,0,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" Margin="5,10,5,5">
                    <Button Content="Применить фильтр" Padding="12,6" Click="ApplyFilterButton_Click"/>
                    <Button Content="Сохранить результат в WAV" Margin="10,0,0,0" Padding="12,6" Click="SaveFilteredButton_Click"/>
                </WrapPanel>

                <TextBlock Grid.Row="2" Margin="5,10,5,0" TextWrapping="Wrap">
                    Результат применяется к исходному сигналу (по ДПФ/БПФ) с умножением спектра на идеальную частотную характеристику.
                </TextBlock>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Margin="10" Header="Результат">
            <TextBox x:Name="ResultBox" MinHeight="140" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
        </GroupBox>
    </Grid>
</Window>